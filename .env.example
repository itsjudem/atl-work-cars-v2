# Copy to .env.local for local development. Never commit .env.local.
# Every value here is optional: the site builds and runs with all of them empty.

# ---- Server-only (never prefix with NEXT_PUBLIC_) ----
# If set, every application and contact-form submission is POSTed here as JSON.
# Test with a free URL from https://webhook.site
LEAD_WEBHOOK_URL=

# ---- Public: baked into browser code at build time (redeploy after changing) ----
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads account ID, e.g. AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads conversion label for a submitted application
NEXT_PUBLIC_GOOGLE_ADS_APPLY_LABEL=
# Google Ads conversion label for a submitted contact form
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=
# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
